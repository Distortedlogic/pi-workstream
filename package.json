{
	"name": "pi-workstream",
	"version": "0.1.0",
	"description": "One native Pi extension for plans, queued work, todo state, and reviewed context compression.",
	"private": true,
	"repository": {
		"type": "git",
		"url": "git+https://github.com/Distortedlogic/pi-workstream.git"
	},
	"homepage": "https://github.com/Distortedlogic/pi-workstream#readme",
	"type": "module",
	"workspaces": ["packages/*"],
	"license": "MIT",
	"engines": {
		"node": ">=22.19.0"
	},
	"scripts": {
		"build:libs": "npm run build --workspace @pi-context-tree/core && npm run build --workspace @pi-context-tree/tui",
		"prepare": "npm run build:libs",
		"check": "npm run build:libs && npm run typecheck && npm run lint",
		"typecheck": "tsc --noEmit",
		"lint": "biome check .",
		"format": "biome check --write ."
	},
	"dependencies": {
		"@juicesharp/rpiv-config": "^2.7.1",
		"@pi-context-tree/core": "file:packages/core",
		"@pi-context-tree/tui": "file:packages/tui",
		"typebox": "1.3.7"
	},
	"peerDependencies": {
		"@earendil-works/pi-ai": "*",
		"@earendil-works/pi-coding-agent": "*",
		"@earendil-works/pi-tui": "*",
		"@juicesharp/rpiv-i18n": "*"
	},
	"peerDependenciesMeta": {
		"@juicesharp/rpiv-i18n": {
			"optional": true
		}
	},
	"devDependencies": {
		"@biomejs/biome": "1.9.4",
		"@earendil-works/pi-ai": "0.84.3",
		"@earendil-works/pi-coding-agent": "0.84.3",
		"@earendil-works/pi-tui": "0.84.3",
		"@juicesharp/rpiv-i18n": "^2.7.1",
		"@types/node": "^22.10.0",
		"typescript": "^5.7.0"
	},
	"files": [
		"src",
		"packages/core/dist",
		"packages/core/package.json",
		"packages/tui/dist",
		"packages/tui/package.json",
		"skills",
		"LICENSE",
		"README.md",
		"THIRD_PARTY_NOTICES.md"
	],
	"pi": {
		"extensions": ["./src/index.ts"],
		"skills": ["./skills"]
	}
}
