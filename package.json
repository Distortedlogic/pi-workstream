{
	"name": "pi-workstream",
	"version": "0.3.0",
	"description": "A native Pi pipeline for disk-backed plans, isolated batch execution, and reviewed compression.",
	"private": true,
	"license": "MIT",
	"repository": {
		"type": "git",
		"url": "git+https://github.com/Distortedlogic/pi-workstream.git"
	},
	"homepage": "https://github.com/Distortedlogic/pi-workstream",
	"type": "module",
	"engines": {
		"node": ">=22.19.0"
	},
	"scripts": {
		"test": "vitest run test/plan.test.ts test/workstream.integration.test.ts",
		"test:e2e": "vitest run test/workstream.e2e.test.ts --testTimeout=180000",
		"check": "npm run typecheck && npm run lint",
		"typecheck": "tsc --noEmit",
		"lint": "biome check .",
		"format": "biome check --write ."
	},
	"dependencies": {
		"@pi-context-tree/core": "0.3.1",
		"mdast-util-to-string": "4.0.0",
		"remark": "15.0.1",
		"remark-gfm": "4.0.1",
		"typebox": "1.3.7",
		"unist-util-visit": "5.0.0",
		"write-file-atomic": "8.0.0"
	},
	"peerDependencies": {
		"@earendil-works/pi-coding-agent": "0.84.3"
	},
	"devDependencies": {
		"@biomejs/biome": "1.9.4",
		"@earendil-works/pi-ai": "0.84.3",
		"@earendil-works/pi-coding-agent": "0.84.3",
		"@types/mdast": "^4.0.4",
		"@types/node": "^22.10.0",
		"@types/write-file-atomic": "^4.0.3",
		"p-wait-for": "6.0.0",
		"typescript": "^5.7.0",
		"vitest": "4.1.11"
	},
	"files": ["src"],
	"pi": {
		"extensions": ["./src/workstream.ts"]
	}
}
