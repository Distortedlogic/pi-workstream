{
	"name": "pi-workstream",
	"version": "0.3.0",
	"description": "A single native Pi workstream engine for plan execution and context compression.",
	"private": true,
	"repository": {
		"type": "git",
		"url": "git+https://github.com/Distortedlogic/pi-workstream.git"
	},
	"homepage": "https://github.com/Distortedlogic/pi-workstream",
	"type": "module",
	"engines": {
		"node": ">=22.19.0"
	},
	"scripts": {
		"test": "vitest run",
		"check": "npm run typecheck && npm run lint",
		"typecheck": "tsc --noEmit",
		"lint": "biome check .",
		"format": "biome check --write ."
	},
	"dependencies": {
		"@pi-context-tree/core": "0.1.1",
		"@sindresorhus/slugify": "^2.2.1",
		"mdast-util-to-string": "^4.0.0",
		"remark-gfm": "^4.0.1",
		"remark-parse": "^11.0.0",
		"typebox": "1.3.7",
		"unified": "^11.0.5",
		"unist-util-visit": "^5.0.0",
		"write-file-atomic": "^6.0.0"
	},
	"peerDependencies": {
		"@earendil-works/pi-coding-agent": "*"
	},
	"devDependencies": {
		"@biomejs/biome": "1.9.4",
		"@earendil-works/pi-ai": "0.84.3",
		"@earendil-works/pi-coding-agent": "0.84.3",
		"@types/mdast": "^4.0.4",
		"@types/node": "^22.10.0",
		"@types/write-file-atomic": "^4.0.3",
		"typescript": "^5.7.0",
		"vitest": "4.1.9"
	},
	"files": ["src"],
	"pi": {
		"extensions": ["./src/workstream.ts"]
	}
}
